# Dependencies / build output are ignored per-app; keep root clean.
.DS_Store
*.log
.env
.idea/
.vscode/

# Local docker env sample (contains dev DB password); use .env.example instead
apps/api/.env.docker
.env.docker
*.pem
*.key
auth.json

# Database backups (written by scripts/backup.sh and the db-backup compose service)
backups/

# Runtime-generated artifacts (should not be committed)
apps/api/storage/app/private/certificates/
apps/api/storage/framework/views/*.php
apps/api/storage/framework/views/*.blade.php
apps/api/storage/framework/cache/*.php
apps/api/storage/framework/testing/disks/
apps/api/bootstrap/cache/packages.php
apps/api/bootstrap/cache/services.php

# --- Repository stabilization (W05–W07): runtime artifacts, never commit ---
apps/api/storage/app/private/exports/
apps/api/storage/framework/cache/data/
apps/api/storage/app/*.b64
apps/api/storage/app/i18n_splice.cjs

# Temporary transfer / quarantine artifacts (delete these folders manually)
/_to_delete/
/_pkg001_to_delete/
/_pkg001_web_src.tgz
/_w05_removed/
apps/web/.spdtest

apps/api/.deptrac.cache

# W09: real production secrets + local UAT evidence (never commit)
apps/api/.env.production
apps/web/.env.production
apps/api/.env.production.*
apps/web/.env.production.*
docs/verification/w09/evidence/

# --- Post-Wave-2 consolidation: QA artifacts, generated GA evidence, runtime uploads, temp scripts (never commit) ---
# Local QA screenshots / sweep outputs (new runs). NOTE: 44 legacy artifacts remain tracked from an
# earlier commit; this only hides NEW untracked ones.
artifacts/
# Generated GA verification-run evidence bundles (container logs, gate outputs, scans) — mirrors the
# already-ignored w09/evidence. Authored docs under docs/ (e.g. docs/audits/*.md) stay tracked.
docs/verification/ga/evidence/
# Runtime uploaded media + Livewire temp uploads (local media store), and Octane runtime state.
apps/api/storage/app/public/media/
apps/api/storage/app/private/livewire-tmp/
# Operator-supplied source images staged for import (course covers, trainer portraits). Real people's
# photographs — kept on disk as the labelled recovery copy, never committed. See docs/ops/LOCAL_QA_RUNBOOK.md.
apps/api/storage/app/private/manual-import/
apps/api/storage/logs/*.json
# One-off local SQL + QA scripts that must never ship.
_relink.sql
_update_courses.sql
apps/api/qa_role_map.php
