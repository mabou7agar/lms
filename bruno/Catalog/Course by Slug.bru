meta {
  name: Course by Slug
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/courses/{{courseSlug}}
  body: none
  auth: none
}

tests {
  test("returns a public course", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.slug).to.equal(bru.getVar("courseSlug"));
  });
}
