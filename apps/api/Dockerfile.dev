# HElbaron API — local development image (PHP 8.3 CLI).
# Uses mlocati's extension installer for reliable PDO PostgreSQL + friends.
FROM php:8.3-cli

ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions \
    && install-php-extensions pdo_pgsql pgsql mbstring bcmath intl zip pcntl

# Composer (copied from the official image)
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# FrankenPHP lives in the image, not in the project directory.
#
# `php artisan octane:install` drops a ~160MB static binary at the project root, and in the dev
# compose file that root is a bind mount from the Windows host. Every cold start then has to drag
# the whole file across the 9p/virtiofs bridge before it can execute, while Octane's
# `frankenphp build-info` probe allows it 60 seconds (Symfony Process's default) before throwing
# ProcessTimedOutException and killing the boot. The container only ever came up because
# `restart: unless-stopped` retried once the host had the file cached.
#
# Here it is read from the image's own filesystem instead, so the boot never depends on the bind
# mount being warm. Octane's ExecutableFinder searches PATH before the project root, so this copy is
# the one that gets used and the project-root binary (if present) is ignored. Pinned rather than
# `latest` because this is the runtime the app boots on — a silent upgrade here is a silent
# PHP-version change.
ADD https://github.com/php/frankenphp/releases/download/v1.12.7/frankenphp-linux-x86_64-gnu /usr/local/bin/frankenphp
RUN chmod +x /usr/local/bin/frankenphp

WORKDIR /var/www/html

# CLI memory (+ timezone). The base php:8.3-cli has no loaded php.ini and defaults memory_limit to
# 128M, which OOMs `artisan test` (Pest runs the whole suite in one process). Bake a 1G CLI budget
# into conf.d so it applies to every php invocation in the container without a per-command override.
COPY infra/php/cli.ini /usr/local/etc/php/conf.d/zz-cli.ini

# Redis is used via the pure-PHP predis client, so no php-redis extension is needed.
EXPOSE 8000
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
