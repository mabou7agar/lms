# HELBARON API — production environment TEMPLATE (placeholders only; contains NO secrets).
# Copy to .env on the production host and replace every <...>. `php artisan config:validate --strict`
# must pass before serving traffic (also enforced at web boot by ProductionConfigValidator).

APP_NAME=HELBARON
APP_ENV=production
APP_KEY=            # <generate: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://api.<your-domain>
APP_VERSION=        # <deploy commit SHA, injected by the pipeline>

# Host / proxy allow-lists (required behind a load balancer)
APP_TRUSTED_HOSTS=api.<your-domain>
TRUSTED_PROXIES=<lb-cidr, e.g. 10.0.0.0/8>   # or a comma-separated CIDR list

# Database (PostgreSQL 16, externally managed)
DB_CONNECTION=pgsql
DB_HOST=<db-host>
DB_PORT=5432
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# Redis (cache, queue, session)
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

# Logging (structured, shippable; never debug in prod)
LOG_CHANNEL=stack
LOG_LEVEL=info

# Mail
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=no-reply@<your-domain>
MAIL_FROM_NAME=HELBARON

# Media (never "fake" in prod)
MEDIA_INGESTION_PROVIDER=<mux|s3>

# Provider notifications (never fake in prod)
NOTIFICATIONS_MAIL_PROVIDER=<mailgun>
NOTIFICATIONS_SMS_PROVIDER=<twilio>
NOTIFICATIONS_PUSH_PROVIDER=<firebase>
NOTIFICATIONS_ALLOW_FAKE=false

# AI is opt-in. Keep disabled until a real enabled provider and credentials are configured.
AI_ENABLED=false
AI_PROVIDER=openai
AI_FAKE_ENABLED=false
AI_ALLOW_FAKE=false
AI_OPENAI_ENABLED=false
OPENAI_API_KEY=<optional-until-ai-enabled>

# Payments (never "fake" in prod unless COMMERCE_ALLOW_FAKE_GATEWAY=true for a non-payment env)
COMMERCE_PAYMENT_PROVIDER=<stripe|paymob|moyasar|hyperpay|tap|aps>
COMMERCE_WEBHOOK_SECRET=<real-webhook-signing-secret>
COMMERCE_ALLOW_FAKE_GATEWAY=false

# Security headers / HSTS (defaults are safe; override only if needed)
SECURITY_HSTS_ENABLED=true

# Error reporting (optional)
SENTRY_LARAVEL_DSN=<optional-sentry-dsn>
