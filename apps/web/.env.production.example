# HELBARON Web (Next.js) — production environment TEMPLATE (placeholders only; NO secrets).
# Only NEXT_PUBLIC_* values reach the browser bundle — never put a secret behind that prefix
# (the build/start fails fast via src/lib/config/env.ts if you do).

# Public (shipped to the browser)
NEXT_PUBLIC_API_BASE_URL=https://api.<your-domain>/api/v1
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# Server-only (SSR + BFF proxy; NOT exposed to the browser)
API_INTERNAL_URL=http://api.internal:8000/api/v1

# Optional error reporting (public DSN is fine; source maps stay server-side)
# NEXT_PUBLIC_SENTRY_DSN=<optional-public-sentry-dsn>

NODE_ENV=production
