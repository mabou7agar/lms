# HElbaron Web — environment contract.
#
# TWO CLASSES OF VARIABLE (enforced by src/lib/env.ts at server startup):
#   * NEXT_PUBLIC_*  — inlined into the CLIENT bundle at build time. World-readable.
#                      NEVER put a secret here (the env contract rejects secret-shaped names).
#   * server-only    — available only in the Node runtime (route handlers, server components,
#                      middleware). Safe for secrets; never shipped to the browser.
#
# In production, missing/unsafe required values fail fast at startup (see src/instrumentation.ts).

# ---- Public (browser-visible) — REQUIRED in production ----
# Public base URL of the HElbaron REST API (version-prefixed).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public origin of this web app (used for sitemap/robots URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Public (browser-visible) — optional ----
# Default UI locale for the scaffold (en | ar). RTL is derived from this.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Build/version stamp surfaced by the liveness endpoint (/api/health) and error reporting.
NEXT_PUBLIC_APP_VERSION=1.0.0-rc.1

# Optional client error tracker (Sentry). Public DSNs are safe to expose; leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# ---- Server-only (never NEXT_PUBLIC_; safe for secrets) ----
# Standalone server listen config (set by the Docker image; override only if needed).
# PORT=3000
# HOSTNAME=0.0.0.0
#
# Add server-side integration secrets here WITHOUT a NEXT_PUBLIC_ prefix, e.g.:
# SESSION_SECRET=
# BACKEND_INTERNAL_URL=
